# Server-side Gemini API key for grocery price estimation and receipt scanning
GEMINI_API_KEY=

# Optional: Anthropic API key. When set, the goal importer looks up store SKUs/ASINs with Claude + web search first.
ANTHROPIC_API_KEY=
# Optional: override the model used for retail lookups (default claude-opus-5-5).
# ANTHROPIC_RETAIL_MODEL=

# Optional: Best Buy Products API key (free at developer.bestbuy.com) for exact Best Buy SKU lookups.
BESTBUY_API_KEY=
